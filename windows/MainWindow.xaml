<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Self-explanatory shell (issue #44): NavigationView with one panel
          per feature, the panel's action button beside its own fields, and
          a single shared result card. No internal jargon on screen.  -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0" x:Name="StatusBar" IsOpen="True" IsClosable="False"
                 Severity="Informational"
                 Message="正在启动内置引擎..." />

        <NavigationView Grid.Row="1" x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="216"
                        SelectionChanged="Nav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="scan" IsSelected="True"
                                    AutomationProperties.AutomationId="nav-scan">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Text="扫描文件" />
                        <TextBlock Text="Scan" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem Tag="doctor"
                                    AutomationProperties.AutomationId="nav-doctor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Text="加密驱动诊断" />
                        <TextBlock Text="Diagnostics" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem Tag="verify"
                                    AutomationProperties.AutomationId="nav-verify">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Text="验证导出文件" />
                        <TextBlock Text="Check Export" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem Tag="decrypt"
                                    AutomationProperties.AutomationId="nav-decrypt">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Text="解密文件" />
                        <TextBlock Text="Decrypt" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem Tag="twin"
                                    AutomationProperties.AutomationId="nav-twin">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE192;" />
                    </NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Text="从文件对恢复密钥" />
                        <TextBlock Text="Recover Key" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem Tag="update"
                                    AutomationProperties.AutomationId="nav-update">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Text="检查更新" />
                        <TextBlock Text="Updates" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="about"
                                    AutomationProperties.AutomationId="nav-about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Text="关于" />
                        <TextBlock Text="About" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  ================= panel host =================  -->
                    <Grid Grid.Row="0" x:Name="PanelHost">

                        <!--  scan (default panel)  -->
                        <Grid x:Name="PanelScan">
                            <ScrollViewer Padding="36,20,36,12">
                                <StackPanel MaxWidth="680" Spacing="14"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="扫描文件" FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="检查一个文件或整个文件夹里，哪些文件带已知的加密壳。只读操作，不会改动任何文件。识别出加密壳不代表文件能直接打开，也不代表已经解密。" />
                                    <TextBlock Text="要检查的位置（文件或文件夹）"
                                               Margin="0,10,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="PathBox"
                                                 PlaceholderText="例如 C:\TestData 或 C:\TestData\sample.pdf"
                                                 AutomationProperties.AutomationId="scan-path"
                                                 AllowDrop="True"
                                                 KeyDown="PathBox_KeyDown" />
                                        <Button Grid.Column="1" x:Name="BrowseScanButton"
                                                Content="浏览…" Click="BrowseScan_Click" />
                                    </Grid>
                                    <Button x:Name="ScanButton" Content="开始扫描"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                            IsEnabled="False" Click="Scan_Click"
                                            AutomationProperties.AutomationId="scan-button" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  doctor  -->
                        <Grid x:Name="PanelDoctor" Visibility="Collapsed">
                            <ScrollViewer Padding="36,20,36,12">
                                <StackPanel MaxWidth="680" Spacing="14"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="加密驱动诊断" FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="查看这台电脑上注册了哪些 Windows 过滤驱动——透明加密软件的驱动会出现在这里，这一步不需要管理员权限。以管理员身份运行时，还会额外列出当前正在运行的过滤驱动和卷实例。只读枚举，不会改动任何驱动。" />
                                    <Button x:Name="DoctorButton" Content="开始诊断"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                            IsEnabled="False" Click="Doctor_Click"
                                            AutomationProperties.AutomationId="doctor-button" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  verify export  -->
                        <Grid x:Name="PanelVerify" Visibility="Collapsed">
                            <ScrollViewer Padding="36,20,36,12">
                                <StackPanel MaxWidth="680" Spacing="14"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="验证导出文件" FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="把「已获授权导出的候选文件」和「加密原文件」比对，判断导出是否仍是加密状态。这是比对，不是解密；结果不证明恢复成功。任何情况下都不要删除加密原文件。" />
                                    <TextBlock Text="加密原文件" Margin="0,10,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="VerifyOriginalBox"
                                                 PlaceholderText="可直接拖入文件，或点右侧浏览"
                                                 AutomationProperties.AutomationId="verify-original-path"
                                                 AllowDrop="True" />
                                        <Button Grid.Column="1" x:Name="BrowseVerifyOriginalButton"
                                                Content="浏览…" Click="BrowseVerifyOriginal_Click" />
                                    </Grid>
                                    <TextBlock Text="已获授权导出的文件" Margin="0,6,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="VerifyExportBox"
                                                 PlaceholderText="可直接拖入文件，或点右侧浏览"
                                                 AutomationProperties.AutomationId="approved-export-path"
                                                 AllowDrop="True" />
                                        <Button Grid.Column="1" x:Name="BrowseVerifyExportButton"
                                                Content="浏览…" Click="BrowseVerifyExport_Click" />
                                    </Grid>
                                    <Button x:Name="VerifyButton" Content="开始比对"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                            IsEnabled="False" Click="Verify_Click"
                                            AutomationProperties.AutomationId="verify-export-button" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  decrypt  -->
                        <Grid x:Name="PanelDecrypt" Visibility="Collapsed">
                            <ScrollViewer Padding="36,20,36,12">
                                <StackPanel MaxWidth="680" Spacing="14"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="解密文件" FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="把一个带加密壳的文件解密成普通文件，写到指定的输出位置。需要选择之前恢复出的密钥文件。原始文件不会被改动；没有密钥时会直接失败，不会生成残缺文件。" />
                                    <TextBlock Text="加密的输入文件" Margin="0,10,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="DecryptInputBox"
                                                 PlaceholderText="可直接拖入文件，或点右侧浏览"
                                                 AutomationProperties.AutomationId="decrypt-input-path"
                                                 AllowDrop="True" />
                                        <Button Grid.Column="1" x:Name="BrowseDecryptInputButton"
                                                Content="浏览…" Click="BrowseDecryptInput_Click" />
                                    </Grid>
                                    <TextBlock Text="密钥文件" Margin="0,6,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="DecryptPadBox"
                                                 PlaceholderText="可直接拖入密钥文件，或点右侧浏览"
                                                 AutomationProperties.AutomationId="decrypt-pad-path"
                                                 AllowDrop="True" />
                                        <Button Grid.Column="1" x:Name="BrowseDecryptPadButton"
                                                Content="浏览…" Click="BrowseDecryptPad_Click" />
                                    </Grid>
                                    <TextBlock Text="解密输出到（自动生成）" Margin="0,6,0,0" />
                                    <TextBox x:Name="DecryptOutputBox"
                                             IsReadOnly="True"
                                             AutomationProperties.AutomationId="decrypt-output-path" />
                                    <Button x:Name="DecryptButton" Content="开始解密"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                            IsEnabled="False" Click="Decrypt_Click"
                                            AutomationProperties.AutomationId="decrypt-button" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  twin / key recovery  -->
                        <Grid x:Name="PanelTwin" Visibility="Collapsed">
                            <ScrollViewer Padding="36,20,36,12">
                                <StackPanel MaxWidth="680" Spacing="14"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="从文件对恢复密钥" FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="准备同一文件的两个版本：一个能正常打开（明文版），一个是加密版。恢复出的加密密钥只写到你指定的文件，不会显示在界面上。两份文件的内容必须来自同一个文件。" />
                                    <TextBlock Text="明文版本（能正常打开的文件）" Margin="0,10,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TwinPlainBox"
                                                 PlaceholderText="可直接拖入文件，或点右侧浏览"
                                                 AutomationProperties.AutomationId="twin-plain-path"
                                                 AllowDrop="True" />
                                        <Button Grid.Column="1" x:Name="BrowseTwinPlainButton"
                                                Content="浏览…" Click="BrowseTwinPlain_Click" />
                                    </Grid>
                                    <TextBlock Text="加密版本（同一文件的加密副本）" Margin="0,6,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TwinCipherBox"
                                                 PlaceholderText="可直接拖入文件，或点右侧浏览"
                                                 AutomationProperties.AutomationId="twin-cipher-path"
                                                 AllowDrop="True" />
                                        <Button Grid.Column="1" x:Name="BrowseTwinCipherButton"
                                                Content="浏览…" Click="BrowseTwinCipher_Click" />
                                    </Grid>
                                    <TextBlock Text="密钥保存到" Margin="0,6,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TwinOutputBox"
                                                 PlaceholderText="例如 D:\Keys\fileboundary.key.json"
                                                 AutomationProperties.AutomationId="twin-output-path" />
                                        <Button Grid.Column="1" x:Name="BrowseTwinOutputButton"
                                                Content="选择位置…" Click="BrowseTwinOutput_Click" />
                                    </Grid>
                                    <Button x:Name="TwinButton" Content="开始恢复"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                            IsEnabled="False" Click="Twin_Click"
                                            AutomationProperties.AutomationId="pad-twin-button" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  update panel (docs/update-contract.md): silent
                              throttled launch check + manual check, in-app
                              download with cancel, quit-and-install handoff  -->
                        <Grid x:Name="PanelUpdate" Visibility="Collapsed">
                            <ScrollViewer Padding="36,20,36,12">
                                <StackPanel MaxWidth="680" Spacing="14"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="检查更新" FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateCurrentVersionText"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="当前版本：读取中…" />
                                    <CheckBox x:Name="UpdateAutoCheckToggle"
                                              Content="启动时自动检查更新（每 4 小时最多一次）"
                                              IsChecked="True"
                                              Checked="UpdateAutoCheck_Toggled"
                                              Unchecked="UpdateAutoCheck_Toggled"
                                              IsEnabled="False"
                                              AutomationProperties.AutomationId="update-auto-check-toggle" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="启动后会静默检查 GitHub Releases 上的新版本（可用上方开关关闭），也可在此手动检查。更新包先下载并通过校验，经你确认后再安装；安装失败会自动保留原版本。" />
                                    <Button x:Name="UpdateCheckButton" Content="检查更新"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                            IsEnabled="False" Click="UpdateCheck_Click"
                                            AutomationProperties.AutomationId="update-check-button" />
                                    <InfoBar x:Name="UpdateDownloadBar"
                                             Severity="Informational"
                                             Title="正在下载更新…"
                                             IsOpen="False" IsClosable="False">
                                        <InfoBar.Content>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10" Margin="0,4,0,0">
                                                <ProgressRing x:Name="UpdateDownloadProgress"
                                                              Width="28" Height="28"
                                                              IsIndeterminate="True" />
                                                <TextBlock x:Name="UpdateDownloadPercentText"
                                                           VerticalAlignment="Center"
                                                           Text="" />
                                                <Button x:Name="UpdateDownloadCancelButton"
                                                        Content="取消下载"
                                                        Click="UpdateCancel_Click" />
                                            </StackPanel>
                                        </InfoBar.Content>
                                    </InfoBar>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!--  ================= shared result card =================  -->
                    <!--  MaxHeight keeps long results from pushing the
                          panel's action buttons out of the viewport: the
                          text area scrolls inside the card instead.  -->
                    <Border Grid.Row="1" x:Name="ResultCard" Visibility="Collapsed"
                            Margin="36,0,36,16" Padding="16,12"
                            CornerRadius="8"
                            MaxHeight="400"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="ResultTitle" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="CopyResultButton" Content="复制"
                                        Click="CopyResult_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="8,2" FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,4,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Enabled">
                                <TextBlock x:Name="ResultText" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           FontSize="13"
                                           AutomationProperties.AutomationId="scan-result" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
